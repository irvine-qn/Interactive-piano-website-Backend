// Schema database của Fiano. Mỗi feature thêm model của mình kèm một migration riêng.
// Sau khi sửa file này: npm run db:migrate -- --name <ten_thay_doi>

generator client {
  // Sinh client JavaScript vào node_modules/@prisma/client (dự án dùng JS CommonJS, không dùng TypeScript)
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== Feature: Sheet Library =====

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

// Bài upload mặc định PRIVATE (chỉ người upload thấy), người dùng tự bật PUBLIC để hiện trong Library.
// Bài mẫu (seed) là PUBLIC.
enum Visibility {
  PUBLIC
  PRIVATE
}

model Sheet {
  id            String      @id // slug, ví dụ "canon-in-d"
  title         String
  subtitle      String?
  composer      String
  difficulty    Difficulty
  tags          String[]
  bpm           Int
  timeSignature Int[]       @map("time_signature") // [tử số, mẫu số], ví dụ [3, 4]
  keySignature  String?     @map("key_signature") // ví dụ "D major"
  durationSec   Int         @map("duration_sec")
  noteCount     Int         @map("note_count")
  views         Int         @default(0)
  likes         Int         @default(0)
  coverColor    String      @default("yellow") @map("cover_color") // yellow | pink | mint | lavender
  // Mảng nốt [{ midi, name, time, duration, velocity, hand }]. Chỉ lấy khi xem chi tiết, không lấy ở danh sách.
  notes         Json
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  likedBy       SheetLike[]
  // ===== Feature: User upload sheet =====
  // null = bài mẫu (seed). Xoá tài khoản thì bài vẫn còn, chỉ mất thông tin người upload.
  uploaderId    Int?        @map("uploader_id")
  uploader      User?       @relation("UploadedSheets", fields: [uploaderId], references: [id], onDelete: SetNull)
  visibility    Visibility  @default(PUBLIC)
  file          SheetFile?
  practiceSessions PracticeSession[]

  @@index([uploaderId])
  @@map("sheets")
}

// File MIDI gốc của bài upload, để chuyển lại khi engine tốt hơn / chọn lại track / tải lại file.
// Bảng riêng để truy vấn danh sách bài không đọc kèm file. Chỉ đọc/ghi qua src/lib/fileStorage.js
// (local lưu ở đây; khi deploy chuyển sang Cloud, xem WBS U-BE-12).
model SheetFile {
  sheetId      String   @id @map("sheet_id")
  sheet        Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  data         Bytes
  originalName String   @map("original_name") @db.VarChar(255)
  size         Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("sheet_files")
}

// ===== Feature: Auth =====
// Khớp đúng bảng `users` mà Auth tạo trước đây bằng SQL (độ dài theo auth.constants.js)

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String?  @map("display_name") @db.VarChar(100)
  role         String   @default("user") @db.VarChar(20)
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  bio               String?  @db.VarChar(160)
  city              String?  @db.VarChar(100)
  country           String?  @db.VarChar(100)
  instagram         String?  @db.VarChar(30)
  level             String?  @db.VarChar(20)
  favoriteGenres    String[] @default([]) @map("favorite_genres")
  favoriteArtists   String[] @default([]) @map("favorite_artists")
  showPracticeStats Boolean  @default(true) @map("show_practice_stats")
  likedSheets  SheetLike[]
  practiceSessions PracticeSession[]
  uploadedSheets Sheet[]     @relation("UploadedSheets")
  avatarUrl      String?     @map("avatar_url") @db.VarChar(255)
  backgroundUrl  String?     @map("background_url") @db.VarChar(255)
  images         UserImage[]

  @@map("users")
}

// Ảnh hồ sơ tạm lưu trong PostgreSQL, sau này chuyển sang Cloudinary
model UserImage {
  userId   Int    @map("user_id")
  kind     String @db.VarChar(20) // avatar | background
  data     Bytes
  mimeType String @map("mime_type") @db.VarChar(50)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
  @@map("user_images")
}

model SheetLike {
  userId    Int      @map("user_id")
  sheetId   String   @map("sheet_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sheet     Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@id([userId, sheetId])
  @@index([sheetId])
  @@map("sheet_likes")
}

model PracticeSession {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  sheetId     String   @map("sheet_id")
  noteCount   Int      @map("note_count")
  durationSec Int      @map("duration_sec")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sheet       Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sheetId])
  @@map("practice_sessions")
}
