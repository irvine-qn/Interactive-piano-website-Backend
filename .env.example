# Copy file này thành .env rồi chỉnh theo máy của bạn
PORT=5000

# PostgreSQL chạy bằng docker compose
POSTGRES_USER=fiano
POSTGRES_PASSWORD=fiano
POSTGRES_DB=fiano
# Đổi port nếu máy đã có Postgres khác chiếm 5432 (nhớ đổi cả trong DATABASE_URL)
POSTGRES_PORT=5432

DATABASE_URL=postgresql://fiano:fiano@localhost:5432/fiano?schema=public
