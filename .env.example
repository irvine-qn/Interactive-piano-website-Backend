# Copy file này thành .env rồi chỉnh theo máy của bạn
PORT=5000

# PostgreSQL chạy bằng docker compose
POSTGRES_USER=fiano
POSTGRES_PASSWORD=fiano
POSTGRES_DB=fiano
# Đổi port nếu máy đã có Postgres khác chiếm 5432 (nhớ đổi cả trong DATABASE_URL)
POSTGRES_PORT=5432

DATABASE_URL=postgresql://fiano:fiano@localhost:5432/fiano?schema=public

# Auth (JWT). Đổi JWT_SECRET thành chuỗi ngẫu nhiên dài trên máy của bạn
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Nơi lưu file MIDI gốc của bài upload. Local dùng postgres (bảng sheet_files); khi deploy sẽ có thêm Cloud
FILE_STORAGE=postgres

# Dia chi Frontend, dung de tao link trong email xac thuc va dat lai mat khau
APP_URL=http://localhost:5173

# Domain Frontend duoc goi API (CORS), nhieu domain thi cach nhau dau phay.
# Bo trong khi chay local (cho moi domain). Production bat buoc, vd https://fiano.date,https://www.fiano.date
CORS_ORIGIN=

# So proxy dung truoc server de lay dung IP nguoi dung cho rate limit. Local: 0. Railway: 1
TRUST_PROXY=0

# Gui email. Co RESEND_API_KEY thi gui qua Resend (dung khi deploy), khong thi dung SMTP ben duoi.
# Bo trong ca hai khi chay local thi link duoc in ra console thay vi gui that.
# Gui qua Resend thi MAIL_FROM phai dung domain da xac minh tren Resend, vd Fiano <no-reply@fiano.date>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fiano <no-reply@fiano.local>
